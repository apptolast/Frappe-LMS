apiVersion: v1
kind: Secret
metadata:
  name: frappe-lms-secret
  namespace: apptolast-frappe-lms
  labels:
    app: frappe-lms
    environment: production
type: Opaque
stringData:
  # ============================================
  # INSTRUCCIONES:
  # 1. Copia este archivo como 01-secret.yaml
  # 2. Rellena los valores con passwords seguros
  # 3. NO subas 01-secret.yaml al repositorio
  # ============================================
  
  # Contraseña de MariaDB root
  # Generar con: openssl rand -base64 32
  MYSQL_ROOT_PASSWORD: "CAMBIAR_ESTO"
  
  # Contraseña del admin de Frappe (usuario: Administrator)
  # Generar con: openssl rand -base64 32
  FRAPPE_ADMIN_PASSWORD: "CAMBIAR_ESTO"
  
  # Clave de encriptación de Frappe
  # Generar con: openssl rand -hex 16
  ENCRYPTION_KEY: "CAMBIAR_ESTO"
